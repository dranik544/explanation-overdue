[sub_resource type="GDScript" id=11]
script/source = "extends Node2D

onready var bg1 = $bg1   # первый спрайт
onready var bg2 = $bg2   # второй спрайт (должен быть с той же текстурой)

var spriteWidth: float

func _ready():
	spriteWidth = bg1.texture.get_width()
	
	bg1.position = Vector2.ZERO
	bg2.position = Vector2(spriteWidth, 0)

func _process(delta):
	var offset = Global.speedLoc * delta   # двигаем влево (отрицательное направление)
	
	bg1.position.x -= offset * 0.2
	bg2.position.x -= offset * 0.2
	
	if bg1.position.x + spriteWidth < 0:
		bg1.position.x = bg2.position.x + spriteWidth
	elif bg2.position.x + spriteWidth < 0:
		bg2.position.x = bg1.position.x + spriteWidth
"

